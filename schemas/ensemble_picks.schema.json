{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snipertrader.ai/schemas/ensemble_picks.schema.json",
  "title": "EnsemblePicksResponse",
  "description": "GET /picks/ensemble — Quantum Ensemble Picks (P0). Dynamic top 10 from Kafka ensemble_features (key=symbol, 15m) inside the paper universe file. score←ensemble_score, confidence←best_confidence. Skip active_levels=false. refresh_sec is 900. Paper only; live_trading stays false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of_ts_ms", "refresh_sec", "items"],
  "properties": {
    "as_of_ts_ms": { "type": "integer", "minimum": 0 },
    "refresh_sec": { "type": "integer", "const": 900 },
    "items": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/EnsemblePick" }
    }
  },
  "$defs": {
    "EnsemblePick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "symbol", "asset_class", "score", "setup_types", "confidence"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string", "pattern": "^[A-Z0-9]+$" },
        "asset_class": { "type": "string", "enum": ["crypto", "equity", "futures"] },
        "score": { "type": "number" },
        "setup_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sweep_reclaim",
              "fvg_entry",
              "po3_judas",
              "sd_extension_fade",
              "vwap_pullback_cont",
              "avwap_ob_confluence"
            ]
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "ref_session": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "rank_components": { "type": ["object", "null"] },
        "contributing_factors": { "type": "array", "items": { "type": "string" } },
        "confluence_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
