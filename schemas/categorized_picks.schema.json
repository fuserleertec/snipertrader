{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snipertrader.ai/schemas/categorized_picks.schema.json",
  "title": "CategorizedPicksResponse",
  "description": "GET /picks/categorized — paper/signal-book picks tagged momentum|mean_reversion|confluence|other. refresh_sec is 900. Max 20 items. live_trading stays false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of_ts_ms", "refresh_sec", "items"],
  "properties": {
    "as_of_ts_ms": { "type": "integer", "minimum": 0 },
    "refresh_sec": { "type": "integer", "const": 900 },
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/CategorizedPick" }
    }
  },
  "$defs": {
    "CategorizedPick": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "symbol",
        "asset_class",
        "category",
        "score",
        "setup_types",
        "confidence"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string", "pattern": "^[A-Z0-9]+$" },
        "asset_class": { "type": "string", "enum": ["crypto", "equity", "futures"] },
        "category": {
          "type": "string",
          "enum": ["momentum", "mean_reversion", "confluence", "other"]
        },
        "score": { "type": "number" },
        "setup_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sweep_reclaim",
              "fvg_entry",
              "po3_judas",
              "sd_extension_fade",
              "vwap_pullback_cont",
              "avwap_ob_confluence"
            ]
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
