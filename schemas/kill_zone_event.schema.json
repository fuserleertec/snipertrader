{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snipertrader.ai/schemas/kill_zone_event.schema.json",
  "title": "KillZoneEvent",
  "description": "Kill-zone start/end event. Kafka topic: kill_zone_events. Redis current zone: kill_zone:{symbol} (exact payload). Class-level lookup: kill_zone:active:{asset_class} (same fields minus symbol). Wire payload has NO schema_version (Phase 2 contract).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol",
    "kill_zone",
    "start_time",
    "end_time",
    "active",
    "asset_class"
  ],
  "properties": {
    "symbol": { "type": "string", "pattern": "^[A-Z0-9]+$" },
    "kill_zone": {
      "type": "string",
      "enum": ["asia", "london", "ny_am", "ny_pm", "rth", "eth", "globex"]
    },
    "start_time": { "type": "integer" },
    "end_time": { "type": "integer" },
    "active": { "type": "boolean" },
    "asset_class": { "type": "string", "enum": ["crypto", "equity", "futures"] }
  }
}
