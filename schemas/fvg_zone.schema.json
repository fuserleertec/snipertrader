{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snipertrader.ai/schemas/fvg_zone.schema.json",
  "title": "FVGZone",
  "description": "Fair-value gap zone (provisional). Redis key: fvg:{symbol}:{id} with TTL ≤ 48h (SETEX/EXPIRE required).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "symbol",
    "asset_class",
    "direction",
    "high",
    "low",
    "created_ts_ms"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "id": { "type": "string" },
    "symbol": { "type": "string", "pattern": "^[A-Z0-9]+$" },
    "asset_class": { "type": "string", "enum": ["crypto", "equity", "futures"] },
    "direction": { "type": "string", "enum": ["bullish", "bearish"] },
    "high": { "type": "number" },
    "low": { "type": "number" },
    "mitigated": { "type": "boolean", "default": false },
    "created_ts_ms": { "type": "integer" },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 172800,
      "description": "Must be ≤ 172800 (48 hours)."
    }
  }
}
