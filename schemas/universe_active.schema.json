{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snipertrader.ai/schemas/universe_active.schema.json",
  "title": "UniverseActive",
  "description": "Authoritative DE-owned universe. Redis key: universe:active. HTTP: GET /v1/universe. Replaces provisional SETUP_UNIVERSE for ML/FE. symbols is the full configured paper list (max 20).",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of_ts_ms", "symbols"],
  "properties": {
    "as_of_ts_ms": { "type": "integer" },
    "symbols": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "asset_class"],
        "properties": {
          "symbol": { "type": "string", "pattern": "^[A-Z0-9]+$" },
          "asset_class": { "type": "string", "enum": ["crypto", "equity", "futures"] }
        }
      }
    },
    "live_trading": { "type": "boolean", "const": false }
  }
}
