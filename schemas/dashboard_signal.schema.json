{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snipertrader.ai/schemas/dashboard_signal.schema.json",
  "title": "DashboardSignal",
  "description": "Frontend dashboard Signal row from GET /signals (history = this list with from_ts/to_ts; there is no /signals/history), GET /signals/{id}, and WS /ws/signals. Same setup_type / timeframe / trigger_event_ids as the ML validate candidate, plus id, status, realized_r, exit_price, closed_ts_ms.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ts_ms",
    "symbol",
    "asset_class",
    "setup_type",
    "side",
    "entry",
    "stop",
    "target",
    "status",
    "confidence",
    "timeframe",
    "ref_session",
    "trigger_event_ids"
  ],
  "properties": {
    "id": { "type": "string" },
    "ts_ms": { "type": "integer" },
    "symbol": { "type": "string", "pattern": "^[A-Z0-9]+$" },
    "asset_class": { "type": "string", "enum": ["crypto", "equity", "futures"] },
    "setup_type": {
      "type": "string",
      "enum": [
        "sweep_reclaim",
        "fvg_entry",
        "po3_judas",
        "sd_extension_fade",
        "vwap_pullback_cont",
        "avwap_ob_confluence"
      ]
    },
    "side": { "type": "string", "enum": ["long", "short"] },
    "entry": { "type": ["number", "null"] },
    "stop": { "type": ["number", "null"] },
    "target": { "type": ["number", "null"] },
    "status": { "type": "string", "enum": ["ACTIVE", "TP_HIT", "SL_HIT", "CANCELLED"] },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "timeframe": { "type": ["string", "null"], "enum": ["1m", "5m", "15m", null] },
    "ref_session": { "type": ["string", "null"] },
    "trigger_event_ids": { "type": "array", "items": { "type": "string" } },
    "realized_r": {
      "type": ["number", "null"],
      "description": "Signed R multiple achieved on TP_HIT / SL_HIT. Null for ACTIVE and CANCELLED."
    },
    "exit_price": {
      "type": ["number", "null"],
      "description": "Fill price when TP/SL hits. Optional."
    },
    "closed_ts_ms": {
      "type": ["integer", "null"],
      "description": "UTC epoch ms when the signal left ACTIVE. Optional."
    },
    "exit_px": { "type": ["number", "null"], "description": "Alias of exit_price (storage / Grafana)." },
    "r_multiple": { "type": ["number", "null"], "description": "Alias of realized_r (storage / Grafana)." },
    "outcome": {
      "type": ["string", "null"],
      "enum": ["win", "loss", "cancelled", null],
      "description": "win | loss | cancelled. Additive (Phase 2)."
    }
  }
}
