{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snipertrader.ai/schemas/ensemble_features.schema.json",
  "title": "EnsembleFeatures",
  "description": "Kafka topic ensemble_features (key=symbol). 15-minute ML snapshots, schema_version 1.1. Quant GET /picks/ensemble maps score←ensemble_score and confidence←best_confidence. Skip active_levels=false. Paper only; live_trading stays false.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "symbol", "ts_ms"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "symbol": { "type": "string", "pattern": "^[A-Z0-9]+$", "description": "Also the Kafka message key." },
    "asset_class": {
      "type": ["string", "null"],
      "enum": ["crypto", "equity", "futures", null]
    },
    "ts_ms": { "type": "integer", "minimum": 0, "description": "Snapshot UTC epoch ms (15m bucket)." },
    "timeframe": { "type": "string", "const": "15m" },
    "ensemble_score": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "Preferred pick score. If omitted, Quant recomputes from rank_components."
    },
    "rank_components": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "ML publisher 0–100 lock: setup_quality, confluence, kill_zone, volume, freshness. risk_adjusted is a legacy alias for confluence. Quant recomputes ensemble_score with weights 40/20/15/15/10 when ensemble_score is omitted.",
      "properties": {
        "setup_quality": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "confluence": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "risk_adjusted": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Legacy alias for confluence." },
        "kill_zone": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "volume": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "freshness": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "best_confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Mapped to pick confidence."
    },
    "active_levels": {
      "type": "boolean",
      "description": "false → Quant skips this symbol (not ranked)."
    },
    "skip_reason": { "type": ["string", "null"] },
    "contributing_factors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confluence_count": { "type": ["integer", "null"], "minimum": 0 },
    "setup_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sweep_reclaim",
          "fvg_entry",
          "po3_judas",
          "sd_extension_fade",
          "vwap_pullback_cont",
          "avwap_ob_confluence"
        ]
      }
    },
    "ref_session": { "type": ["string", "null"] }
  }
}
