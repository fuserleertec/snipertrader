{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snipertrader.ai/schemas/order_block.schema.json",
  "title": "OrderBlock",
  "description": "Order-block zone. Kafka topic order_block_zones. Redis key: ob:{symbol}:{id} with TTL ≤ 48h.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "symbol",
    "asset_class",
    "direction",
    "high",
    "low",
    "created_ts_ms"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "id": { "type": "string" },
    "symbol": { "type": "string", "pattern": "^[A-Z0-9]+$" },
    "asset_class": { "type": "string", "enum": ["crypto", "equity", "futures"] },
    "direction": { "type": "string", "enum": ["bullish", "bearish"] },
    "high": { "type": "number" },
    "low": { "type": "number" },
    "created_ts_ms": { "type": "integer" },
    "mitigated": { "type": "boolean", "default": false },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 172800,
      "description": "Must be ≤ 172800 (48 hours)."
    },
    "timeframe": { "type": "string", "enum": ["1m", "5m", "15m", "1h", "4h"] },
    "displacement_ts_ms": { "type": "integer" },
    "origin_open": { "type": "number" },
    "origin_close": { "type": "number" }
  }
}
