# Kronos backend environment variables (copy to .env, never commit .env)
# Alpaca Data API credentials — https://app.alpaca.markets/ (paper or live)
ALPACA_API_KEY=your_alpaca_api_key_id
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_TRADE_HOST=paper-api.alpaca.markets

# AI provider keys (OpenAI-compatible chat APIs)
# DeepSeek — https://platform.deepseek.com/  (models: deepseek-chat, deepseek-reasoner)
DEEPSEEK_API_KEY=your_deepseek_key
KIMI_API_KEY=your_kimi_key
# Optional model overrides:
# DEEPSEEK_MODEL=deepseek-chat
# KIMI_MODEL=moonshot-v1-8k

# Optional: port for the Kronos inference backend
# KRONOS_PORT=8787
