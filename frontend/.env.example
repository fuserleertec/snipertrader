# Data Engineering API (VWAP / session / OHLCV)
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Empty = same-origin /v1/* rewritten to the Data Eng HTTP API
NEXT_PUBLIC_HTTP_BASE=http://localhost:8000

# Quant Developers API (setup/trade signals — post risk-approval)
NEXT_PUBLIC_QUANT_HTTP_BASE=http://localhost:8000
NEXT_PUBLIC_QUANT_WS_BASE=ws://localhost:8000

# true (default) = in-browser mock streams matching the contracts
# false = live WS/HTTP against Data Eng + Quant
NEXT_PUBLIC_USE_MOCKS=true
