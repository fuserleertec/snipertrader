# Data Eng — market data + OHLCV + Phase 2 streams + pattern overlay WS
# Phase 2 (PR #5) when NEXT_PUBLIC_USE_MOCKS=false:
#   GET/WS /v1/avwap           payload: anchor_id, symbol, anchor_time, anchor_price,
#                              vwap_value, bands.{plus|minus}_{1,2,3}_sigma, asset_class
#   GET/WS /v1/volume-profile  payload: symbol, session_type, high_volume_nodes,
#                              low_volume_nodes, poc, timestamp
#                              GET /v1/volume-profile/{symbol} may wrap { profiles:[{value}] }
#   GET/WS /v1/kill-zone       payload: symbol, kill_zone, start_time, end_time, active, asset_class
# Pattern sockets (LIVE on DE PR #5): seed SCAN then pub/sub.
# Frames = raw /schemas JSON (schema_version 1.1). NO wrapper envelope.
#   WS /v1/ws/sweep?symbol=
#   WS /v1/ws/fvg?symbol=
#   WS /v1/ws/mss?symbol=
#   WS /v1/ws/ob?symbol=
# Example:
#   const ws = new WebSocket("ws://localhost:8000/v1/ws/avwap?symbol=BTCUSDT");
#   ws.onmessage = (e) => JSON.parse(e.data);
NEXT_PUBLIC_HTTP_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Quant OpenAPI (PR #2) — signals + performance + signal WS
# Local: cd quant && sniper-quant api --inmemory --port 8001
# Docs:  http://localhost:8001/docs
NEXT_PUBLIC_QUANT_API_BASE=http://localhost:8001
NEXT_PUBLIC_QUANT_WS_BASE=ws://localhost:8001

# NEXT_PUBLIC_QUANT_HTTP_BASE is accepted as an alias of QUANT_API_BASE.

# DE PR #12 LIVE: GET /v1/universe/top?limit=10|20 (schemas/universe_top.schema.json)
# Paper QA against local backends: NEXT_PUBLIC_USE_MOCKS=false
# true (default) = in-browser mock fallback only. Live miss never substitutes mocks.
NEXT_PUBLIC_USE_MOCKS=true

# Quant :8001 + DE :8000. Paper only. live_trading stays false.
# GET /picks/ensemble        → P0 top 10, refresh_sec=900
# GET /picks/categorized     → P4 ≤20
# GET /signals + /signals/history → P2 multi-symbol ~20
# GET /v1/universe/top?limit=10|20 → chart/universe selector (not GET /v1/universe)
# GET/WS /v1/ohlcv|vwap|session|avwap|volume-profile|kill-zone → per-symbol
# 15m refresh from as_of_ts_ms / refresh_sec=900.
