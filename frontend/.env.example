# Data Eng (PR #8 / PR #5) — market data + OHLCV + pattern overlay WS
# Pattern sockets (LIVE on DE PR #5): seed SCAN then pub/sub.
# Frames = raw /schemas JSON (schema_version 1.1). NO wrapper envelope.
#   WS /v1/ws/sweep?symbol=
#   WS /v1/ws/fvg?symbol=
#   WS /v1/ws/mss?symbol=
#   WS /v1/ws/ob?symbol=
# Example:
#   const ws = new WebSocket("ws://localhost:8000/v1/ws/sweep?symbol=BTCUSDT");
#   ws.onmessage = (e) => JSON.parse(e.data);
NEXT_PUBLIC_HTTP_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Quant OpenAPI (PR #2) — signals + performance + signal WS
# Local: cd quant && sniper-quant api --inmemory --port 8001
# Docs:  http://localhost:8001/docs
NEXT_PUBLIC_QUANT_API_BASE=http://localhost:8001
NEXT_PUBLIC_QUANT_WS_BASE=ws://localhost:8001

# NEXT_PUBLIC_QUANT_HTTP_BASE is accepted as an alias of QUANT_API_BASE.

# Pattern overlay WS go live only when this is false AND NEXT_PUBLIC_WS_BASE is set.
# true (default) = in-browser mock fallback (same raw 1.1 frames).
NEXT_PUBLIC_USE_MOCKS=true
