# Data Engineering API (default when NEXT_PUBLIC_USE_MOCKS=false)
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Empty = same-origin /v1/* rewritten to the Data Eng HTTP API
NEXT_PUBLIC_HTTP_BASE=http://localhost:8000

# true (default) = in-browser mock streams matching schema_version "1.1"
# false = live WS/HTTP against the Data Eng + Quant APIs
NEXT_PUBLIC_USE_MOCKS=true
