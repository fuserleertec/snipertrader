# Copy to .env — never commit real keys.

# --- Runtime ---
SNIPER_ENV=demo
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Brokers / stores (docker compose defaults) ---
KAFKA_BOOTSTRAP=localhost:19092
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://sniper:sniper@localhost:5432/market

# --- Pipeline ---
DEMO_SYMBOLS=BTCUSDT,AAPL,ES
ROLLING_VWAP_PERIODS=20
FVG_TTL_SECONDS=172800
TICK_INTERVAL_MS=80
KILLZONE_INPROCESS=true
KILLZONE_POLL_S=1
METRICS_PORT=0
MAX_ANCHORS_PER_SYMBOL=32
SWING_DETECT=true
SWING_LEFT=2
SWING_RIGHT=2
SWING_LOOKBACK=5
RISK_VALIDATE_URL=http://localhost:8001/risk/validate

# --- Quant walk-forward setup defaults ---
SETUP_ATR_PERIOD=14
SETUP_STOP_BUFFER_ATR=0.05
SETUP1_MIN_RR=2.0
SETUP1_MSS_SWING_LOOKBACK=5
SETUP1_MAX_BARS_SWEEP_TO_MSS=15
SETUP1_REQUIRE_CONFIRMED_SWEEP=true
SETUP1_TIMEFRAMES=5m,15m
SETUP2_OVERLAP_TOL_ATR=0.05
SETUP2_PIN_WICK_RATIO=2.5
SETUP2_MAX_FVG_AGE_HOURS=24
SETUP2_TARGET_RR_FALLBACK=2.0
SETUP3_ACCUM_SESSION=asia
SETUP3_KILL_ZONE=ny_am
SETUP3_DISPLACEMENT_MIN_BODY_ATR=1.2
SETUP3_REQUIRE_BAND_TAG=true
SETUP3_MAX_BARS_SWEEP_TO_DISPLACE=6
SETUP_DEDUPE_WINDOW_SEC=300
SETUP_MIN_CONVICTION_TO_VALIDATE=60

# --- Exchange stubs (optional; mock feed does not need these) ---
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_WS_URL=wss://stream.binance.com:9443/ws
# BINANCE_REST_URL=https://api.binance.com
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_DATA_WS_URL=wss://stream.data.alpaca.markets/v2/iex
