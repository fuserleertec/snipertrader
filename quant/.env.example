# Copy to .env — never commit real keys.

SNIPER_ENV=demo
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8001

# Same Timescale / Redis world as data_engineering/
DATABASE_URL=postgresql://sniper:sniper@localhost:5432/market
REDIS_URL=redis://localhost:6379/0

USE_INMEMORY=false
DEFAULT_EQUITY=100000
RISK_FRACTION=0.02
MAX_DAILY_LOSS_FRAC=0.03
CORR_LOOKBACK_DAYS=60
CORR_THRESHOLD=0.70
SL_ATR_MULTIPLE=2.0
TP_R_MULTIPLE=2.0
MIN_RR=1.5
COMMISSION_BPS=1.0
SLIPPAGE_BPS=2.0
ACCOUNT_ID=default
