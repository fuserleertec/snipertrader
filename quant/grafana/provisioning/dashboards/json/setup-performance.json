      "title": "All locked setup_types (1–6)",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescale" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH locked(setup_type) AS (VALUES ('sweep_reclaim'),('fvg_entry'),('po3_judas'),('sd_extension_fade'),('vwap_pullback_cont'),('avwap_ob_confluence')) SELECT l.setup_type, COALESCE(SUM(p.n_signals), 0) AS n_signals, COALESCE(AVG(p.win_rate), 0) AS win_rate, COALESCE(AVG(p.avg_rr), 0) AS avg_realized_r FROM locked l LEFT JOIN signal_performance p ON p.setup_type = l.setup_type AND p.day >= NOW() - INTERVAL '30 days' WHERE l.setup_type IN (${setup_type:sqlstring}) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    }
